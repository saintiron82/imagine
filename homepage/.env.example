# ── 프런트(빌드 시 주입, VITE_ 접두) ─────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Cloudflare Pages Functions 환경변수 (대시보드/.dev.vars) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# 플랜 → Stripe Price ID 매핑 (연 구독)
STRIPE_PRICE_STUDIO=price_...
STRIPE_PRICE_TEAM=price_...
# Firebase Admin (라이선스 원장 쓰기) — 서비스 계정 JSON 을 한 줄로
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
FIREBASE_PROJECT_ID=imagine-b1e9c
# 결제 성공/취소 리다이렉트 베이스
PUBLIC_BASE_URL=https://imagine.app
