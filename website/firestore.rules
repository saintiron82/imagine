rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Releases — public read, admin write only
    match /releases/{releaseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'saintiron82@gmail.com';
    }

    // Groups — public read (discovery), public write (server registration)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    // Board posts — authenticated users can read all, write rules per category
    match /posts/{postId} {
      allow read: if request.auth != null;
      // notice: admin only; free/inquiry: any authenticated user
      allow create: if request.auth != null
        && (request.resource.data.category in ['free', 'inquiry']
            || request.auth.token.email == 'saintiron82@gmail.com');
      // update/delete: own posts or admin
      allow update, delete: if request.auth != null
        && (resource.data.author_email == request.auth.token.email
            || request.auth.token.email == 'saintiron82@gmail.com');

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
          && (resource.data.author_email == request.auth.token.email
              || request.auth.token.email == 'saintiron82@gmail.com');
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
