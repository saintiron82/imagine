rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Releases — public read, admin write only
    match /releases/{releaseId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'saintiron82@gmail.com';
    }

    // Groups — public read (discovery), public write (server registration)
    match /groups/{groupId} {
      allow read: if true;
      allow write: if true;
    }

    // Board posts — authenticated read, admin write
    match /board/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'saintiron82@gmail.com';
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
